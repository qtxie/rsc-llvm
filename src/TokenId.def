#ifndef TOK
#define TOK(ID)
#endif
#ifndef OPERATOR
#define OPERATOR(ID, STR) TOK(ID)
#endif
#ifndef DELIMITER
#define DELIMITER(ID, STR) TOK(ID)
#endif
#ifndef KEYWORD
#define KEYWORD(ID, ID_LOWER) TOK(ID)
#endif
#ifndef MACRO
#define MACRO(ID, ID_LOWER) TOK(Macro ## ID)
#endif

TOK(Unknown)             // Not a token.
TOK(Eof)                 // End of file.
TOK(Directive)

TOK(Issue)               // #abc
TOK(Word)                // abc123
TOK(LitWord)             // 'abc
TOK(GetWord)             // :abc
TOK(SetWord)             // abc:
TOK(Refinement)          // /local
TOK(SetColon)            // colon at the tail. e.g. abc:
TOK(GetColon)            // colon at the beginning. e.g. :abc
TOK(Hex)                 // 12ABh
TOK(Byte)                // #"a"
TOK(Integer)             // 123
TOK(Float)               // 1.23
TOK(String)              // "abc"
TOK(MultilineString)     // {abc}
TOK(File)                // %abc.reds
TOK(Binary)              // #{ABCD}

OPERATOR(Plus,               "+")
OPERATOR(Minus,              "-")
OPERATOR(Slash,              "/")     // when attach to previous symbol
OPERATOR(Div,                "/")
OPERATOR(Modulo,             "//")
OPERATOR(Remainder,          "%")

DELIMITER(LParen,            "(")
DELIMITER(RParen,            ")")
DELIMITER(LBracket,          "[")
DELIMITER(RBracket,          "]")

// @@ Note: Keep in ascend order
KEYWORD(Star,                "*")
KEYWORD(Less,                "<")
KEYWORD(ShiftLeft,           "<<")
KEYWORD(LessEqual,           "<=")
KEYWORD(NotEqual,            "<>")
KEYWORD(Equal,               "=")
KEYWORD(Greater,             ">")
KEYWORD(GreaterEqual,        ">=")
KEYWORD(ShiftRight,          ">>")
KEYWORD(ShiftRightLogical,   ">>>")
KEYWORD(Alias,               "alias")
KEYWORD(All,                 "all")
KEYWORD(And,                 "and")
KEYWORD(Any,                 "any")
KEYWORD(As,                  "as")
KEYWORD(Assert,              "assert")
KEYWORD(Break,               "break")
KEYWORD(Case,                "case")
KEYWORD(Catch,               "catch")
KEYWORD(Context,             "context")
KEYWORD(Continue,            "continue")
KEYWORD(Declare,             "declare")
KEYWORD(Either,              "either")
KEYWORD(Exit,                "exit"  )
KEYWORD(False,               "false" )
KEYWORD(Func,                "func"  )
KEYWORD(Function,            "function")
KEYWORD(If,                  "if"    )
KEYWORD(Loop,                "loop"  )
KEYWORD(Not,                 "not"   )
KEYWORD(Null,                "null"  )
KEYWORD(Or,                  "or"    )
KEYWORD(Pop,                 "pop"   )
KEYWORD(Push,                "push"  )
KEYWORD(Return,              "return")
KEYWORD(Size,                "size"  )
KEYWORD(Struct,              "struct")
KEYWORD(Switch,              "switch")
KEYWORD(Throw,               "throw" )
KEYWORD(True,                "true"  )
KEYWORD(Until,               "until" )
KEYWORD(Use,                 "use"   )
KEYWORD(While,               "while" )
KEYWORD(With,                "with"  )
KEYWORD(Xor,                 "xor"   )

// @@ Note: Keep in ascend order
MACRO(Call,                 "call")
MACRO(Case,                 "case")
MACRO(Define,               "define")
MACRO(Either,               "either")
MACRO(Enum,                 "enum")
MACRO(Export,               "export")
MACRO(If,                   "if")
MACRO(Import,               "import")
MACRO(Include,              "include")
MACRO(Inline,               "inline")
MACRO(Script,               "script")
MACRO(Switch,               "switch")
MACRO(Syscall,              "syscall")
MACRO(U16,                  "u16")
MACRO(Verbose,              "verbose")

#undef MACRO
#undef KEYWORD
#undef DELIMITER
#undef OPERATOR
#undef TOK