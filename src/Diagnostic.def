#ifndef DIAG
#define DIAG(ID, Level, Msg)
#endif

DIAG(err_wrong_header, Error, "invalid Red/System header")

DIAG(err_invalid_token, Error, "invalid token")
DIAG(err_unknown_directive, Error, "unknown directive")
DIAG(err_invalid_utf8, Error, "invalid UTF-8 sequence")

DIAG(warn_macro_redefined, Warning, "macro in R/S is redefined")

DIAG(err_circular_ref, Error, "cirular reference is not allowed")
DIAG(err_dangling, Error, "dangling {0}")
DIAG(err_expected_match, Error, "expected {0} to match this {1}")
DIAG(err_expected, Error, "expected {0}")
DIAG(err_expected_arg, Error, "expected {0} but found {1}")
DIAG(err_expected_type, Error, "expected type {0} but found {1}")
DIAG(err_invalid_func, Error, "invalid definition for function")
DIAG(err_invalid_assign, Error, "nested assignment in expression not supported")
DIAG(err_not_initialized, Error, "local variable {0} used before being initialized!")

DIAG(err_float_overflow, Error, "float overflow")
DIAG(err_int_overflow, Error, "integer overflow")
DIAG(err_invalid_path, Error, "invalid path")
DIAG(err_invalid_cascade, Error, "cannot cascade declare {0}")
DIAG(err_invalid_type, Error, "invalid type")
DIAG(err_invalid_struct, Error, "invalid struct syntax: {0}")
DIAG(err_invalid_enum, Error, "invalid enumeration syntax: {0}")
DIAG(err_redefine_keyword, Error, "attempt to redefine a protected keyword: {0}")
DIAG(err_cannot_declared, Error, "declaring a {0} at this level is not allowed")
DIAG(err_symbol_declared, Error, "symbol {0} already declared")
DIAG(err_types_for_operator_not_compatible, Error, "types not compatible for operator {0}")
DIAG(err_undeclared_name, Error, "undeclared name {0}")

DIAG(err_type_not_compatible, Error, "type of formal and actual parameter are not compatible")
DIAG(err_requires_return, Error, "Function requires RETURN with value")
DIAG(err_return_type, Error, "Type of RETURN value is not compatible with function type")

DIAG(err_not_yet_implemented, Error, "feature is not yet implemented")

#undef DIAG