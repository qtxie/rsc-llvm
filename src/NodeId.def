#ifndef NODE
#define NODE(ID, STR) Node ## ID,
#endif
#ifndef TYPE
#define TYPE(ID, STR) Type ## ID,
#endif

// @@ order of the types are important!
// see TypeConv array in Parser.cpp
// see emitCall in CodeGen.cpp
TYPE(Void,               "void!")
TYPE(Null,               "null!")
TYPE(Bool,               "logic!")
TYPE(Byte,               "byte!")
TYPE(Int,                "integer!")
TYPE(Float,              "float32!")
TYPE(Double,             "float64!")
TYPE(Enum,               "enum!")
TYPE(Ptr,                "pointer!")
TYPE(Struct,             "struct!")
TYPE(Func,               "function!")
TYPE(CStr,               "c-string!")
TYPE(Array,              "array")
TYPE(Type,               "anytype!")
TYPE(Alias,              "alias!")
TYPE(FuncTy,             "func-spec")
TYPE(FuncUnresolved,     "unresolved-func")
TYPE(StructUnresolved,   "unresolved-struct")
TYPE(End,                "type-end")

NODE(Assign,             "assignment")
NODE(FnCall,             "func-call")
NODE(Var,                "variable")
NODE(Ident,              "identifier")
NODE(MemberAccess,       "member-access")
NODE(PtrIdx,             "ptr-idx")
NODE(Context,            "context")
NODE(Ptr,                "pointer")
NODE(GetAddr,            "get-address")
NODE(Add,                "+")
NODE(Sub,                "-")
NODE(Mul,                "*")
NODE(Div,                "/")
NODE(Modulo,             "//")
NODE(Remainder,          "%")
NODE(And,                "and")
NODE(Or,                 "or")
NODE(Xor,                "xor")
NODE(Eq,                 "=")
NODE(Less,               "<")
NODE(Greater,            ">")
NODE(LessEq,             "<=")
NODE(GreaterEq,          ">=")
NODE(NotEq,              "<>")
NODE(ShiftLeft,          "<<")
NODE(ShiftRight,         ">>")
NODE(ShiftRightLogical,  ">>>")
NODE(Not,                "not")
NODE(Any,                "any")
NODE(All,                "all")
NODE(Return,             "return")
NODE(Exit,               "exit")
NODE(Break,              "break")
NODE(Continue,           "continue")
NODE(Throw,              "throw")
NODE(Catch,              "catch")
NODE(If,                 "if")
NODE(Either,             "either")
NODE(Switch,             "switch")
NODE(Case,               "case")
NODE(While,              "while")
NODE(Until,              "until")
NODE(Loop,               "loop")
NODE(Cast,               "cast")
NODE(SizeOf,             "size?")
NODE(Declare,            "declare")
NODE(Member,             "struct-member")
NODE(Null,               "null")
NODE(WithDecl,           "with-decls")
NODE(Array,              "array")
NODE(LiteralArray,       "literal-array")

#undef TYPE
#undef NODE